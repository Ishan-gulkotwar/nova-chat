# Copy to backend/.env and adjust. Never commit the real .env.
APP_NAME="Nova Chat"
ENVIRONMENT=development
# JSON list of browser origins allowed to call the API
CORS_ORIGINS=["http://localhost:5173"]

# --- Security ---
# Random secret used to encrypt saved API keys. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing it later makes saved API keys unreadable (you'd re-enter them).
SECRET_KEY=change-me

# --- LLM providers ---
# Cloud providers (Groq, OpenAI, Anthropic...) are added in the app under Settings.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=4096

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./nova_chat.db
DATABASE_ECHO=false
